{
  "name": "ply-js",
  "version": "0.0.3",
  "description": "A TypeScript port based on python-plyfile for reading and writing .ply files",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "example": "ts-node --project tsconfig.examples.json examples/simple-metrics.ts",
    "run:example": "ts-node --project tsconfig.examples.json examples/simple-metrics.ts",
    "example:dev": "npx ts-node examples/simple-metrics.ts",
    "example:height": "ts-node --project tsconfig.examples.json examples/height.ts --full",
    "example:weight": "ts-node --project tsconfig.examples.json examples/weight.ts --full",
    "example:summary": "ts-node --project tsconfig.examples.json examples/summary.ts --full",
    "calibrate": "ts-node --project tsconfig.examples.json examples/calibrate.ts",
    "apply:calibration": "ts-node --project tsconfig.examples.json examples/apply-calibration.ts",
    "test": "jest --config=jest.config.ts",
    "test:cov": "NODE_OPTIONS=--max-old-space-size=4096 APP_ENV=local jest --config=jest.config.ts --coverage --coverageReporters=lcov --coverageReporters=json-summary --coverageReporters=text --runInBand",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoDiogo/ply-js.git"
  },
  "keywords": [
    "ply",
    "3d",
    "mesh",
    "point cloud",
    "geometry",
    "typescript"
  ],
  "author": "GustavoDiogo",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/GustavoDiogo/ply-js/issues"
  },
  "homepage": "https://github.com/GustavoDiogo/ply-js#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.12",
    "jest": "^30.0.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist",
    "README.md",
    "COPYING"
  ],
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
